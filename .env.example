# Respaldo para versión web o builds de producción.
# En el celular con Expo Go NO hace falta fijarla: la app deduce la IP de la PC
# desde la propia conexión de Expo (ver src/services/apiClient.js).
EXPO_PUBLIC_API_URL=http://localhost:3001
# Puerto de la API (solo si cambia el 3001 por defecto):
# EXPO_PUBLIC_API_PORT=3001
